{
  "name": "@tarahi/cfnsync",
  "version": "0.1.0",
  "packageManager": "pnpm@11.2.2",
  "description": "Sync a directory of raw CloudFormation templates to stacks (detect changes, create/diff/execute change sets, manage stacks in dependency order).",
  "type": "module",
  "license": "MIT",
  "author": "tarahiman",
  "homepage": "https://github.com/tarahiman/cfnsync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarahiman/cfnsync.git"
  },
  "bugs": {
    "url": "https://github.com/tarahiman/cfnsync/issues"
  },
  "keywords": [
    "cloudformation",
    "aws",
    "cfn",
    "iac",
    "change-set",
    "deploy",
    "cli",
    "ci"
  ],
  "bin": {
    "cfnsync": "dist/cli/main.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "npm-shrinkwrap.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate:shrinkwrap": "node scripts/generate-shrinkwrap.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "sync:skill-references": "node scripts/sync-skill-references.mjs",
    "check:skill-references": "node scripts/sync-skill-references.mjs --check",
    "check:docs": "node scripts/check-doc-links.mjs && node scripts/check-spec-ids.mjs",
    "prepack": "pnpm run generate:shrinkwrap && pnpm run clean && pnpm run build && pnpm run verify:dist",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings . && node scripts/check-control-chars.mjs && node scripts/check-message-language.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "quality:check": "pnpm run check:skill-references && pnpm run check:docs && pnpm run format:check && pnpm run lint && pnpm run typecheck:test && pnpm test && pnpm run build",
    "gitleaks:install": "sh scripts/install-gitleaks.sh",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:setup": "pnpm run gitleaks:install && pnpm run hooks:install"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "3.1090.0",
    "@aws-sdk/client-s3": "3.1090.0",
    "@aws-sdk/client-sts": "3.1090.0",
    "@aws-sdk/credential-provider-node": "3.972.70",
    "commander": "12.1.0",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@types/node": "^24",
    "aws-sdk-client-mock": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
