{
  "$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
  "files": {
    "includes": [
      "src/**",
      "test/**",
      ".mcp.json",
      "package.json",
      "tsconfig.json",
      "vitest.config.ts",
      "biome.json",
      "!docs",
      "!README.md",
      "!dist",
      "!node_modules",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noTemplateCurlyInString": "off"
      }
    }
  }
}
