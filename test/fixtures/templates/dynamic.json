{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "T-03 fixture (§6) - unresolved dynamic Export.Name and Fn::ImportValue",
  "Parameters": {
    "Environment": {
      "Type": "String"
    }
  },
  "Resources": {
    "Topic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": { "Fn::Sub": "${Environment}-topic" },
        "Tags": [
          {
            "Key": "SharedSecret",
            "Value": {
              "Fn::ImportValue": { "Fn::Sub": "${Environment}-shared-secret" }
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "DynamicExport": {
      "Value": { "Ref": "Topic" },
      "Export": { "Name": { "Fn::Sub": "${Environment}-topic-export" } }
    }
  }
}
